import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class DatabaseInsertDemo {
    private static final String URL = "jdbc:mysql://localhost:3306/mydatabase";
    private static final String USER = "root";
    private static final String PASSWORD = "password";

    public static void main(String[] args) {
        String createTableSQL = "CREATE TABLE IF NOT EXISTS users (" +
                                "id INT AUTO_INCREMENT PRIMARY KEY, " +
                                "name VARCHAR(100), " +
                                "email VARCHAR(100))";

        String insertSQL = "INSERT INTO users (name, email) VALUES (?, ?)";

        try (Connection conn = DriverManager.getConnection(URL, USER, PASSWORD);
             PreparedStatement createStmt = conn.prepareStatement(createTableSQL);
             PreparedStatement insertStmt = conn.prepareStatement(insertSQL)) {

            // Step 4: Create table if it does not exist
            createStmt.execute();

            // Step 5 & 6: Insert first user record
            insertStmt.setString(1, "John Doe");
            insertStmt.setString(2, "john.doe@example.com");
            insertStmt.executeUpdate();

            // Step 7: Insert second user record
            insertStmt.setString(1, "Jane Doe");
            insertStmt.setString(2, "jane.doe@example.com");
            insertStmt.executeUpdate();

            // Step 8: Print success message
            System.out.println("Data inserted successfully.");

        } catch (SQLException e) {
            // Step 9: Handle SQLException
            System.err.println("Database error: " + e.getMessage());
            e.printStackTrace();
        }
    }
}
